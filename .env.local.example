# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# EmailJS — contact form
# Get these from https://dashboard.emailjs.com
# Auto-reply to the sender is configured in the template's own "Auto-Reply" tab in the dashboard — no separate template ID needed here.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=template_xxxxxxx

# n8n — registration form webhook (server-side only, never exposed to browser)
N8N_REGISTRATION_WEBHOOK_URL=https://your-n8n-instance.com/webhook/xxxxxxx

# Umami analytics (privacy-friendly). Leave blank to disable tracking entirely.
# SRC is the tracker script URL from your Umami instance (e.g. https://cloud.umami.is/script.js
# or https://your-umami.example.com/script.js). WEBSITE_ID is the UUID Umami shows for the site.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Google Search Console — the token from the "HTML tag" verification method
# (the content="..." value of the google-site-verification meta tag). Leave blank until you have it.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
