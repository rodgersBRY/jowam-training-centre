# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# EmailJS — contact & quick inquiry forms
# Get these from https://dashboard.emailjs.com
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_INQUIRY_TEMPLATE_ID=template_xxxxxxx

# n8n — registration form webhook (server-side only, never exposed to browser)
N8N_REGISTRATION_WEBHOOK_URL=https://your-n8n-instance.com/webhook/xxxxxxx
